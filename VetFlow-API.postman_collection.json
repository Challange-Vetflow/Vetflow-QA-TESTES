  "item": [
    {
      "name": "Autenticação e cadastro",
      "item": [
        {
          "name": "TC01 - Cadastro de tutor (auto-cadastro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tutor Teste\",\n  \"email\": \"{{tutorEmail}}\",\n  \"phone\": \"11999990000\",\n  \"password\": \"{{tutorPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('tutorEmail', 'tutor.' + Date.now() + '@example.com');",
                  "pm.collectionVariables.set('tutorPassword', 'senha123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC01: Criar tutor e usuário na mesma transação via procedures.",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retorna TUTOR com tutorId', () => { const b = pm.response.json(); pm.expect(b.role).to.eql('TUTOR'); pm.expect(b.tutorId).to.be.a('string'); });",
                  "pm.collectionVariables.set('tutorId', pm.response.json().tutorId);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC02 - E-mail duplicado no cadastro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tutor Duplicado\",\n  \"email\": \"{{tutorEmail}}\",\n  \"phone\": \"11999990001\",\n  \"password\": \"senha123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC02: Garantir que o banco bloqueia e-mail repetido (ORA-20001).",
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Mensagem informa conta já cadastrada', () => pm.expect(pm.response.json().mensagem).to.include('cadastrad'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC03 - Login do tutor e dados da sessão",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{tutorEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{tutorPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC03: Validar autenticação do tutor e o perfil retornado.",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna o próprio tutor', () => { const b = pm.response.json(); pm.expect(b.email).to.eql(pm.collectionVariables.get('tutorEmail')); pm.expect(b.role).to.eql('TUTOR'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC04 - Login com senha incorreta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tutorEmail}}\",\n  \"senha\": \"senha-errada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC04: Garantir que credenciais inválidas são recusadas.",
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
