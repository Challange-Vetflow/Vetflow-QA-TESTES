{
  "info": {
    "name": "VetFlow - Testes Automatizados de API (QA Sprint 4)",
    "description": "Testes automatizados (Postman + Newman) da API Java do VetFlow. Ordem: rode as pastas de cima para baixo. Cada execução cria dados novos (e-mail de tutor único).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{vetEmail}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{vetPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://vetflow-java.onrender.com"
    },
    {
      "key": "vetEmail",
      "value": "vet@vetflow.com"
    },
    {
      "key": "vetPassword",
      "value": "senha123"
    },
    {
      "key": "tutorEmail",
      "value": ""
    },
    {
      "key": "tutorPassword",
      "value": ""
    },
    {
      "key": "tutorId",
      "value": ""
    },
    {
      "key": "petId",
      "value": ""
    },
    {
      "key": "clinicId",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    },
    {
      "key": "dataFutura",
      "value": ""
    },
    {
      "key": "medicationId",
      "value": ""
    }
