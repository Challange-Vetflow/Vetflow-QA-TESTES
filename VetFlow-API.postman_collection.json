            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC10: Veterinária cadastra clínica parceira via SP_INSERT_CLINIC.",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clinicId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC11 - Agendar consulta futura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"petId\": \"{{petId}}\",\n  \"clinicId\": \"{{clinicId}}\",\n  \"scheduledAt\": \"{{dataFutura}}\",\n  \"type\": \"CHECKUP\",\n  \"notes\": \"Check-up anual\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 7*24*3600*1000);",
                  "const p = n => String(n).padStart(2,'0');",
                  "pm.collectionVariables.set('dataFutura', `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T10:00:00`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC11: Agendamento via SP_INSERT_APPOINTMENT (data deve ser futura).",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Consulta não concluída', () => pm.expect(pm.response.json().completed).to.eql(false));",
                  "pm.collectionVariables.set('appointmentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC12 - Marcar consulta como realizada",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "{{appointmentId}}",
                "complete"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC12: Veterinária conclui a consulta agendada.",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Consulta concluída', () => pm.expect(pm.response.json().completed).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
